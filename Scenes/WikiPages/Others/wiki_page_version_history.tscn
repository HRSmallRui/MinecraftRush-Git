[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Version2" index="5"]
layout_mode = 2
theme_override_constants/line_spacing = 5
text = "5个新防御塔（4级炮塔-演算者炮塔，4级箭塔-沙漠哨塔，4级兵营-大刀教会，4级炮塔-湮灭炮塔，沙漠雇佣兵营地）
4个新关卡（8.卡瓦拉沙漠，9.沙漠神殿，10.绝望沙丘，11.东海岸）
11种新敌人（尸壳，尸壳勇士，沙漠狙击手 蠹虫，噩梦幻翼，沙漠守卫，木乃伊，黄金傀儡，沙漠雇佣兵，军火商，巨型尸壳）
2个新英雄（沙漠狙击手-塔尔辛，自然巫师-鲁伯特）
10个新成就"
autowrap_mode = 3

