[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Version4" index="7"]
layout_mode = 2
theme_override_constants/line_spacing = 5
text = "增幅火雨技能：间隔0.6s，降落需花费0.8s -> 间隔0.4s，降落需花费0.6s
增大法辰大招的范围，单发奥术射线伤害调整：120 -> 80
火雨五级的随机陨石数量增加至4颗，伤害额外提高至100-140
史蒂夫金苹果技能改动：史蒂夫生命值少于20%时立即吃下一个金苹果，恢复自身200/250/300生命，并获得持续8/10/12秒的生命恢复效果，每0.5s恢复5生命 -> 史蒂夫生命值少于30%时立即吃下一个金苹果，恢复自身200/250/300生命，并获得持续8/10/12秒的生命恢复效果，每0.5s恢复10生命
渲染引擎从forward+换成了兼容模式，内存占用从700MB降低至300MB
修复了压缩纹理贴图资源之后导致的第二关显示提示大小不正确的bug
我方单位被秒杀后血量显示会变为0
法辰二技能护盾改为自动释放，CD24s -> 36s，持续时间4/5/6s -> 3/4/5s，同时释放时机从血量低于50%改为受伤时释放
第15关初始资金上调：1900 -> 2000
苦力怕类敌人在获得“闪电护盾”buff后不再属于苦力怕类敌人，可以正常受到闪电伤害
修复了苦力怕类敌人被闪电击中后可以无限叠加爆炸范围的bug
修改剧情厌皇的终结技，改为无法秒杀迈克·史密斯
修复了演算者炮塔五级科技下100%眩晕的bug
修复了蔷薇近战拦截时调遣后卡死的bug
PC端在启动器界面可自行选择是否显示十字光标
新增塞勒姆不死骑士被动：塞勒姆在不死骑士附近150范围内死亡时会在1秒后复活"
autowrap_mode = 3

