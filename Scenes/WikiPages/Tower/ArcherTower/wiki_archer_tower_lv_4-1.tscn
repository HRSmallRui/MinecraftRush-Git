text = "黑曜石"

[node name="Label12" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="16"]
layout_mode = 2
text = "价格：200/180/180
 
扔出一颗黑曜石，造成100-120/150-180/200-240点炮伤，并眩晕目标1.5秒。
 
冷却时间：12秒"
autowrap_mode = 3

[node name="MarginContainer7" type="MarginContainer" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="17"]
layout_mode = 2
theme_override_constants/margin_top = 315

[node name="Label11" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="18"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "碎石"

[node name="Label13" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="19"]
layout_mode = 2
text = "价格：250/200
 
每次攻击会在最后命中处炸开碎石，对小范围内的所有敌人造成10-15/15-24点物伤。
 
溅射范围为命中中心点为圆心的44像素半径的圆形区域，锁定地面空中敌人的HurtBox。
 
判定条件：第一次攻击时若未触发弹射则触发该技能，落地时如果没有命中目标也会触发该技能；第二次弹射攻击时无论最后有没有击中在第二次弹射攻击结束后都会触发该技能。"
autowrap_mode = 3

