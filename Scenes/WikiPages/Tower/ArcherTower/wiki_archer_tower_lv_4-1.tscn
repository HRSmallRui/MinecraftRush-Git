[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="12"]
layout_mode = 2
text = "投石高塔的子弹命中敌人后如果以命中点为中心周围 73 像素内有检测到其他敌人的HurtBox，则会额外生成一个子弹攻击随机敌人（排除原命中敌人），继承自原子弹伤害的0.667倍"
autowrap_mode = 3

