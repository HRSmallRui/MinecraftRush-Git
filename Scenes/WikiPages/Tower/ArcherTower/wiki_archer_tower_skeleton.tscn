text = "穿刺"

[node name="Label13" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="15"]
layout_mode = 2
text = "价格：300
 
骷髅狙击塔射出的普通箭矢在命中敌人后会按照原定方向继续飞行0.2 秒，期间如果再次命中敌人则会额外造成原伤害的50%伤害。"
autowrap_mode = 3

