[node name="Label12" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="12"]
layout_mode = 2
text = "价格：250/250/250
 
骷髅狙击塔初始拥有0%的秒杀概率，每次攻击都会进行秒杀判定，如果成功则概率归零并射出特殊的秒杀箭矢（对BOSS无效，会判定秒杀并且概率归零，但是秒杀箭矢对boss只会造成普攻伤害），否则概率增加8%/10%/12%，直到下次秒杀判定成功。"
autowrap_mode = 3

[node name="MarginContainer7" type="MarginContainer" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="13"]
layout_mode = 2
