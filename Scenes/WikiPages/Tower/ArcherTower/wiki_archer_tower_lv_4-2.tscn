[node name="Label12" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="16"]
layout_mode = 2
text = "价格：300/200/200
 
对单个敌人造成115-135 / 200-250 / 310-400点真伤，并有30%/45%/60%概率立即秒杀目标。
 
默认索敌射程内剩余生命值最高的敌人。
 
冷却时间：16秒"
autowrap_mode = 3

