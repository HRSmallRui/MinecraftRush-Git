[node name="Label12" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="16"]
layout_mode = 2
text = "价格：175/100/100
 
释放牢笼困住最多两个敌人2/3/4秒，期间敌人无法行动，依然可以正常受到外界伤害。单个敌人最多被困住4次。
 
默认索敌射程内剩余距离最短的敌人。
 
冷却时间：12秒"
autowrap_mode = 3

