[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Passive" index="1"]
layout_mode = 2
text = "守卫者教堂初始攻击层数为 0 层，攻击力为 3-6，守卫者巫师每次开始攻击时默认锁定射程内现存生命值最高且最后一个进入射程的敌人。
 
锁定敌人后守卫者教堂每 0.25 秒对锁定敌人造成一次伤害，每造成 4 次伤害后伤害叠加一层，最高叠加到 5 层。攻击至多 12 秒后守卫者教堂必定停止攻击并进入冷却。
 
0 层至 5 层伤害量分别为 3-6 / 8-15 / 13-24 / 18-33 / 23-42 / 28-51
 
当因为达到最大攻击时间，敌人离开守卫者教堂射程，敌人死亡而导致守卫者教堂停止攻击时，守卫者教堂冷却时间会随当前攻击层数而改变，0 层至 5 层的攻击冷却时间为 1.5 / 1.8 / 2.1 / 2.4 / 2.7 / 3 秒。"
autowrap_mode = 3

