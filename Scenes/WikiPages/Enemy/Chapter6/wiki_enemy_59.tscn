theme_override_constants/separation = 45

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 45
text = "台词文本"

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="1"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "战前"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="2"]
layout_mode = 2
text = "尔等能走到此地，是吾之慈悲。
 
百年前，先祖曾率军踏破过另一国度的土地，今日尔等小国将面临同样的命运。
 
吾即雷鸣之化身，厌鸣的无敌部队将踏破这里的每一寸土地。
 
颤抖吧，人类。
 
吾早已成神，尔等以为这凡间俗物可以阻挡吾之神威吗。
 
濒死的羔羊，妄图做最后无用的抵抗吗？"
autowrap_mode = 3

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="3"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "战斗"

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="4"]
layout_mode = 2
text = "准备迎接人类灭亡的命运吧。
 
当那个蠢货用举国生灵点燃“禁术”换取神姿之时，或许不曾想到这神器终将回到厌鸣的手中。现在，你们就是历史悲剧的重演。
 
先祖没看透的真相——神器需要的不是蛮力，而是共鸣！现在的雷光，连神都会颤抖！
 
瞧这雷光中闪烁的亡魂面孔——那小国的冤魂还在为神器悲鸣？但它们的诅咒，只会成为我力量的养料！
 
跪下！在雷神的面前！
 
你们以为先前暂时的扭转战局的渺小“奇迹”是神明的庇佑？不过是吾之慈悲，允许尔等在灭亡前多喘两口气罢了。
 
 从地狱爬回来的阴暗爬虫，以为带几支残兵败将就能改写灭亡的历史？
 
听到了吗？亡魂在笑——笑尔等之徒劳。
 
尔等每喘一口气，都是吾对历史之施舍。
 
雷光不度蝼蚁——尔等连做吾踏脚石之资格都勉强。
 
甚好，吾能感受到尔等之无能狂怒。
 
绝望吧，仇恨吧，愤怒吧——然后，在雷光中化为虚无。
 
不过区区凡人，妄图阻挠吾？笑话！
 
厌鸣的无敌部队，将会踏破尔等小国的每一寸土地。九泉之下，尔等将会团聚的，这点大可放心。
 
不过是些凡间俗物，尔等蝼蚁以为如此便可阻止吾之霸业吗？
 
吾早已成神，何来败亡一说？"
autowrap_mode = 3

[node name="Label6" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="5"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "BOSS战"

[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="6"]
layout_mode = 2
text = "退下！一群废柴！还需吾亲自送尔等上路！
 
瞧吾英武之神威，简直就是天神下凡！
 
在尼古拉斯的神威面前颤抖吧，凡人！
 
从今天起，历史只会记住两件事：尼古拉斯・特斯拉的雷霆踏碎了人族，以及你们曾像蛆虫一样在我的脚边蠕动过
 
绝望吧、仇恨吧、愤怒吧——尔等之无能狂怒，正是吾突破极限的养料！
 
吾既成神，何来败亡？
 
不过区区凡人，妄图阻挠吾？笑话！
 
濒死的羔羊，妄图做最后无用的抵抗吗？
 
呵呵……一切皆是徒劳……人族灭亡的命运，不可能被改写……"
autowrap_mode = 3

[node name="Label8" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="7"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "死亡"

[node name="Label9" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Text" index="8"]
layout_mode = 2
text = "这不可能！吾竟然……"
autowrap_mode = 3

