[node name="Label" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Skills" index="2"]
layout_mode = 2
text = "远古守卫者每次会在（1141, 539），（224, 261），（1734, 256）三个位置随机露头，等待 6 秒后如果没有进入破韧状态则会随机从海渊扫灭，寂灭死光，世界末日三个技能当中选择一个进行释放。技能释放结束后等待 6 秒潜回海里，随后等待 8-10 秒再次冒头。
 
远古守卫者潜入海中处于无法选中的无敌状态，并恢复自身等同 5% 血量上限的生命（若此时生命低于 10% ，额外恢复 3% 血量上限的生命）。"
autowrap_mode = 3

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Skills" index="3"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "韧性条"

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Skills" index="4"]
layout_mode = 2
text = "每次远古守卫者冒头时持有 800 韧性（韧性存在期间远古守卫者持有 20% 总伤减免），若血量低于10%则额外获得 200 韧性，我方每对远古守卫者造成 1 点伤害（韧性不持有护甲，魔抗与减伤，与血量分开计算）都将削减 1 点韧性。远古守卫者韧性击破时会陷入僵直，持续 6 秒，此时远古守卫者额外获得易伤效果，受到的所有伤害额外增加 20%，冒头结束潜回海里或僵直恢复时韧性恢复。"
autowrap_mode = 3

