[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Skills" index="2"]
layout_mode = 2
text = "每次释放技能后会消失 4 秒，随后出现在随机位置并在 8 秒后从 雷罚，神罚雷怒，万里神雷 三个技能中随机释放（单个技能不会重复释放第二次），之后停留 5 秒再消失
在某一次出现时如果总时间超过了130 秒，则会蓄力释放必杀拆除所有防御塔并秒杀所有我方单位。
 
无法秒杀持有 “god” 标签的单位。"
autowrap_mode = 3

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Skills" index="3"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "雷罚"

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Skills" index="4"]
layout_mode = 2
text = "向单一我方单位降下雷鸣，对 150 范围内的所有我方单位造成 400 点真伤。"
autowrap_mode = 3

