[node name="Label" type="Label" parent="VBoxContainer" index="2"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 48
text = "英雄机制"
horizontal_alignment = 1

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer" index="3"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2" index="0"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "英雄是我方单位大类中最为强大的独特单位，拥有独立的等级体系、可升级技能和自由调遣能力。本章节介绍英雄的通用规则、分类体系和运作逻辑，帮助你理解整个英雄生态。关于每位英雄的详细数值，请查阅 [我方单位板块]中的[英雄板块]。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer" index="4"]
layout_mode = 2
theme_override_constants/margin_top = 65

[node name="MarginContainer5" type="MarginContainer" parent="VBoxContainer" index="5"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50
theme_override_constants/margin_bottom = 130

[node name="VBoxContainer" type="VBoxContainer" parent="VBoxContainer/MarginContainer5" index="0"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "英雄等级体系"

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "英雄共有 10 级（1 级 ~ 10 级）。每级所需的累计经验值固定，升级后基础属性（生命、攻击等）会相应提升，同时获得一定的技能点数，技能点数可以用于在主地图页面的英雄殿堂页面升级英雄技能，使英雄获得更加多样强大的能力。"
autowrap_mode = 3

[node name="MarginContainer" type="MarginContainer" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="2"]
layout_mode = 2
theme_override_constants/margin_top = 415

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="3"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "不同英雄的初始等级可能不同，具体以解锁时的游戏提示或英雄详情页为准。"
autowrap_mode = 3

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="4"]
layout_mode = 2
theme_override_constants/margin_top = 60

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="5"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "经验获取"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="6"]
layout_mode = 2
text = "英雄通过战斗行为积累经验值，提升等级。对于英雄来讲，共有两种方法可以为英雄提供经验值。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="7"]
layout_mode = 2

[node name="Label6" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="8"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "普通攻击"

[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="9"]
layout_mode = 2
text = "英雄通过普通攻击对敌人造成伤害时，按以下公式获得经验：获得经验 = 伤害原始数值 x 经验倍率。
 
无论是近战攻击还是远程攻击只要命中敌人都会立即获得经验值，前提是近战攻击和远程攻击都要命中敌人，如果无效化或者被闪避则不会获得经验值。
 
每位英雄拥有固定的经验获取倍率，该倍率不随等级提升而变化。"
autowrap_mode = 3

[node name="MarginContainer4" type="MarginContainer" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="10"]
layout_mode = 2

[node name="Label8" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="11"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "技能释放"

[node name="Label9" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="12"]
layout_mode = 2
text = "释放技能时获得的经验为固定值，与造成的伤害量无关。
 
通常情况下，技能等级越高，提供的经验值越高。"
autowrap_mode = 3

[node name="MarginContainer6" type="MarginContainer" parent="VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50
theme_override_constants/margin_bottom = 130

[node name="VBoxContainer" type="VBoxContainer" parent="VBoxContainer/MarginContainer6" index="0"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "英雄技能体系"

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "每位英雄拥有 1 个隐藏被动技能 + 5 个可升级技能，形成完整的技能体系。英雄每提升一级可以获得4点技能点，用于提升5个可升级技能。英雄满级（达到10级）时，所有技能都必定可以达到满级。
 
下表为英雄达到对应等级时可以获得的技能点。"
autowrap_mode = 3

[node name="MarginContainer" type="MarginContainer" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="2"]
layout_mode = 2
theme_override_constants/margin_top = 420

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="3"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "被动技能"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="4"]
layout_mode = 2
text = "所有英雄都自带一个隐藏被动技能，该技能可能会随英雄等级提升而提升，无法被主动升级，也不会在英雄界面单独显示。
 
一个英雄有且仅会有一个被动技能，该技能作为该英雄特色而存在，某些情况下可能是该英雄流派玩法的底层核心机制的存在，每位英雄的具体被动机制详情可以参见英雄板块的每位角色的详细信息介绍。"
autowrap_mode = 3

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="5"]
layout_mode = 2

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "自主技能"

[node name="Label6" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="7"]
layout_mode = 2
text = "所有英雄都拥有四个自主技能，这些技能都可以自主升级，在战场上只要条件成立英雄就会自动释放技能。
 
有些技能可能是纯数值加成或者机制加成，并非所有技能都是可以由英雄自主释放的动作式技能。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="8"]
layout_mode = 2

[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="9"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "主动技能"

[node name="Label8" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="10"]
layout_mode = 2
text = "每位英雄有且仅有1个主动技能，该技能是唯一可以由玩家自主操纵释放的技能，但通常存在冷却限制。这些技能同样可以自主升级，并且与自主技能不同的是主动技能在0级时就可启用，不会因为没有升级而无法使用。
 
每位英雄都各自拥有独特的主动技能，这些主动技能也是构成英雄设计风格的重要组成部分。"
autowrap_mode = 3

