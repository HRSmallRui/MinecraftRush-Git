[node name="Label" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "调遣与移动机制"

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "英雄在战场上的部署和移动拥有最高自由度，移动调遣上英雄可简单分为地面英雄与飞行英雄。
 
英雄可以自由调遣至场上的任何合法位置。"
autowrap_mode = 3

[node name="MarginContainer" type="MarginContainer" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="2"]
layout_mode = 2

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="3"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "地面英雄"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="4"]
layout_mode = 2
text = "英雄仅可部署至道路位置，且通常会通过导航系统沿路径移动至目标地点。移动指令发出后，会朝着目标点以当前自身移速移动。"
autowrap_mode = 3

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="5"]
layout_mode = 2

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "飞行英雄"

[node name="Label6" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="7"]
layout_mode = 2
text = "飞行英雄可自由调集至地图上任意位置，移动指令发出后，必定会无视路径障碍以直线路径移动至目标地点。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="8"]
layout_mode = 2

[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="9"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "移动与瞬移"

[node name="Label8" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="10"]
layout_mode = 2
text = "部分英雄拥有瞬移能力。当移动指令的目标距离过远时，英雄会直接瞬移至目标地点，而非缓慢走过去。
 
瞬移并非所有英雄都具备，仅在少部分英雄的机制中生效。具体哪些英雄拥有瞬移能力，请查阅各英雄详情页。"
autowrap_mode = 3

