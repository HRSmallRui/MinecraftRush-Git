[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="4"]
layout_mode = 2
text = "- 初始生命值
- 初始绿宝石： 用于建造防御塔，升级防御塔，以及升级技能
- 总波次
- 当前波次"
autowrap_mode = 3

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="5"]
layout_mode = 2

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "可用塔列表"

[node name="Label6" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="7"]
layout_mode = 2
text = "该参数是一个长度为 4 的bool数组，索引对应四种基础塔：箭塔，兵营，法师塔，炮塔
 
该参数决定局内哪些玩家防御塔可以被建造，哪些会被禁用。通常情况下，该参数仅影响对应防御塔种类1级防御塔的建造，如果场上初始存在被禁用的防御塔，玩家可以对其进行升级等操作。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="8"]
layout_mode = 2

[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="9"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "波次与召唤配置"

[node name="Label8" type="Label" parent="VBoxContainer/MarginContainer8/VBoxContainer" index="10"]
layout_mode = 2
text = "该参数是每个关卡独立持有的资源配置文件，定义了波次节奏、经济奖励和技能冷却加速。
 
该配置文件包含：
 
每一波结束后到下一波开始之间的等待时间
每一个波次提示出现到强制下一波开始之间的等待时间
每一波提前召唤时可以获得的绿宝石数量
每一波提前召唤时对援军，火雨和主动技能的冷却减少时间。"
autowrap_mode = 3

[node name="MarginContainer7" type="MarginContainer" parent="VBoxContainer" index="8"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50
theme_override_constants/margin_bottom = 130

[node name="VBoxContainer" type="VBoxContainer" parent="VBoxContainer/MarginContainer7" index="0"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "关卡评价机制"

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "通关关卡后会获得不定数量的下界之星用于局外科技升级，因此了解关卡的评价机制也至关重要。
 
对于战役模式，通常会有1-3星评价：
 
- 1星评价： 战斗结束时留存1-4生命值，获得1颗下界之星
- 2星评价： 战斗结束时留存5-17生命值，获得2颗下界之星
- 3星评价： 战斗结束时留存18生命值以上，获得3颗下界之星
 
挑战模式：无论是钻石挑战还是基岩挑战，战斗胜利之后都固定获得1颗下界之星。"
autowrap_mode = 3

[node name="MarginContainer9" type="MarginContainer" parent="VBoxContainer" index="9"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50
theme_override_constants/margin_bottom = 130

[node name="VBoxContainer" type="VBoxContainer" parent="VBoxContainer/MarginContainer9" index="0"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer9/VBoxContainer" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "波次提前召唤"

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer9/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = " 每一个波次即将到来时开始计时，其中波次按钮背后的进度条会随着计时不断增加，直到计时结束时如果玩家依然没有提前开始下一波，则会强制开始下一个波次。如果在此期间玩家提前召唤波次，则会按照剩余时间的比例给予玩家部分绿宝石和减少主动技能冷却时间的奖励。
 
提前因数为：提前波次剩余时间 / 提前波次总剩余时间，若该因数小于0.05则不会触发提前波次召唤奖励，如果因数大于0.9则会自动补全到1，即玩家可以获得完整奖励。
 
奖励为
获得绿宝石： 下一波提前召唤总绿宝石数量 x 提前因数
主动技能冷却时间减少： 下一波提前召唤各自（火雨，援军，英雄主动技能）总冷却时间减少数 x 提前因数"
autowrap_mode = 3

