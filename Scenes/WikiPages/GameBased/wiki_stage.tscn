theme_override_font_sizes/font_size = 24
text = "常见参数
 
 
- 关卡编号
- 关卡允许最高科技等级"
autowrap_mode = 3

[node name="MarginContainer" type="MarginContainer" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="2"]
layout_mode = 2

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="3"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "关卡模式"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="4"]
layout_mode = 2
text = "每个关卡都包含三种模式
 
战役模式：类似于剧情模式，拥有8-16波不等的敌人波次，初始血量20点，是最常见最普通的游戏模式。
 
钻石挑战：战役模式三星通关解锁，为高难度或趣味挑战，拥有5波精锐敌人波次，初始血量1点，一般会限制科技等级。
 
基岩挑战：战役模式三星通关解锁，为高难度或趣味挑战，拥有1波总攻波次，只能查看波次敌人种类，无法查看波次敌人具体数量。初始血量1点，一般会限制科技等级。
 
部分关卡可能不存在挑战模式，只有战役模式。"
autowrap_mode = 3

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="5"]
layout_mode = 2

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "科技等级限制"

[node name="Label6" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="7"]
layout_mode = 2
text = "决定了该关卡中科技加成的最高生效等级。
 
部分关卡挑战模式可能设置较低的科技上限，用于控制难度或强制玩家使用特定策略。具体每关的限制值以关卡详情页为准。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="8"]
layout_mode = 2

[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="9"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "环境标签"

[node name="Label8" type="Label" parent="VBoxContainer/MarginContainer6/VBoxContainer" index="10"]
layout_mode = 2
text = "环境标签会以字符串的形式存储在一个数组内，代表当前关卡的环境类别，同一个关卡可以同时存在多个环境标签。
 
环境标签可能会影响部分技能的释放，例如沙漠关卡会携带\"desert\"标签，这会使鲁伯特的主动技能的下雨效果无法生效。"
autowrap_mode = 3

