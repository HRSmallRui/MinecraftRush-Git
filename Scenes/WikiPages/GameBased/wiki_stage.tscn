[node name="Label" type="Label" parent="VBoxContainer" index="2"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 48
text = "关卡机制"
horizontal_alignment = 1

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer" index="3"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2" index="0"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "关卡是游戏的核心玩法单元，每个关卡拥有独立的配置参数，包括波次节奏、初始资源、可用塔、环境标签等。本章节介绍关卡的通用配置结构与波次运作逻辑。关于具体关卡的详细数据，请查阅[关卡板块]。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer" index="4"]
layout_mode = 2
theme_override_constants/margin_top = 65

[node name="MarginContainer5" type="MarginContainer" parent="VBoxContainer" index="5"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50
theme_override_constants/margin_bottom = 130

[node name="VBoxContainer" type="VBoxContainer" parent="VBoxContainer/MarginContainer5" index="0"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "关卡构成"

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "关卡由以下部件组成
 
 
 
特效管理器： 负责播放特殊视觉效果的管理器。
 
场景摄像机： 负责渲染对应的游戏画面，同时拥有缩放限制和视野移动限制的功能。
 
音频管理器： 这里负责播放大部分通用音效，以及对音效进行统一管理。
 
音乐组： 这里存放着游戏内会用到的局内战斗音乐，分为准备阶段音乐，战斗阶段音乐，Boss阶段音乐。部分情况可能会额外存放其他音乐。
 
背景组： 关卡的场景视觉的重要组成部分，里面主要负责场景的搭建工作，以及用于存放场景可交互组件。
 
导航组： 用于地面英雄的通常移动导航用，每一关都会有独立的导航组。
 
火雨随机点位导航组： 通常包围游戏内的可移动道路与火雨额外攻击点位，用于火雨5级科技随机火雨落点的取点用途。
 
容器组：分别有Enemies/Allys/Towers三个容器，用于分门别类存放游戏单位，其中Enemies容器内分有多条继承自Path2D节点的EnemyPath节点，用于给敌人提供固定路线移动，敌人则负责挂载到EnemyPath节点下执行移动逻辑。
 
UI组：用于绘制游戏窗口UI，例如绿宝石数量，当前血量，波次信息。其他UI信息包括：提示按钮存放组，暂停按钮，主动技能存放组，信息面板，小地图UI。
 
波次按钮： 显示下一波的敌人信息与敌人来源方向，鼠标移动到波次按钮还会显示敌人行进路线。
 
路径检测区： 检测鼠标是否在路径检测区内，用于部分需要在路径释放的技能判定，以及我方单位的移动也需要移动到路径上。
 
下一波倒计时计时器： 每一个波次即将到来时开始计时，其中波次按钮背后的进度条会随着计时不断增加，直到计时结束时如果玩家依然没有提前开始下一波，则会强制开始下一个波次。如果在此期间玩家提前召唤波次，则会按照剩余时间的比例给予玩家部分绿宝石和减少主动技能冷却时间的奖励。
 
下一波次计时器： 每一个波次开始时开始计时，计时结束后会显示下一波即将到来图标，给玩家提供缓冲区。"
autowrap_mode = 3

