text = "主线关卡"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer10/VBoxContainer" index="4"]
layout_mode = 2
text = "游戏的核心推进路线，玩家必定先玩主线，按顺序逐一解锁。
 
默认解锁，或通关前置主线关卡后解锁，基准难度，作为支线关卡的参照。
 
目前主线关卡一共20关"
