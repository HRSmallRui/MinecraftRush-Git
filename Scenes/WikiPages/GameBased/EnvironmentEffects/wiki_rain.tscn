[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer5/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "晴天： 无影响
 
小雨： 降低15%
 
中雨： 降低30%
 
大雨： 降低40%
 
雷暴雨： 降低60%"

[node name="MarginContainer7" type="MarginContainer" parent="VBoxContainer" index="8"]
