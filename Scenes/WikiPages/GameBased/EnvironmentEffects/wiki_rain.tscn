[node name="Label" type="Label" parent="VBoxContainer" index="2"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 48
text = "下雨机制"
horizontal_alignment = 1

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer" index="3"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2" index="0"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "下雨机制共有五个阶段，每个波次开始时改变不同阶段。能见度会随雨势增大而降低（画面变暗），同时雨水会对场上特定单位造成持续伤害。"
autowrap_mode = 3

[node name="MarginContainer3" type="MarginContainer" parent="VBoxContainer" index="4"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer3" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 24
text = "出现关卡：第6关，第7关，第16关，第17关"
autowrap_mode = 3

[node name="MarginContainer4" type="MarginContainer" parent="VBoxContainer" index="5"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 50

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer4" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "阶段：晴天/小雨/中雨/大雨/雷暴雨"
autowrap_mode = 3

[node name="MarginContainer6" type="MarginContainer" parent="VBoxContainer" index="6"]
layout_mode = 2

[node name="MarginContainer5" type="MarginContainer" parent="VBoxContainer" index="7"]
