text = "雷暴雨阶段会定期（每 6 - 12 秒）发生闪电打击："
autowrap_mode = 3

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer10/VBoxContainer" index="2"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "-打闪： 短时间内大幅提高场上亮度
-判定： 对全场持有 “creeper” 标签的敌人进行一次判定
-效果： 30% 概率施加 闪电护盾 buff，同时进入 闪电状态，并移除其“creeper”标签"
