text = "下界之星获取途径"

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer11/VBoxContainer" index="6"]
layout_mode = 2
text = "下界之星是科技升级的唯一消耗资源，通过关卡评价获取。
 
下文为下界之星的获取流程
 
 
 
通关关卡
    ↓
战役模式（初见剧情模式）
    ├── 1星评价 → 获得 1 颗下界之星
    ├── 2星评价 → 获得 2 颗下界之星
    └── 3星评价 → 获得 3 颗下界之星 + 解锁挑战模式
    ↓
挑战模式解锁后
    ├── 钻石挑战 → 通关获得 1 颗下界之星
    └── 基岩挑战 → 通关获得 1 颗下界之星
 
 
部分关卡可能不存在挑战模式。"
autowrap_mode = 3

