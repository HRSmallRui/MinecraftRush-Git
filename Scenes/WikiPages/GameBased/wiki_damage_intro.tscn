theme_override_font_sizes/font_size = 36
text = "7.死亡判定"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer4/VBoxContainer/Damage11" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "当目标生命值降至 0 或以下时，触发死亡事件。部分小体型单位（Small 类型敌人，或者Soldier类型我方单位）在受到爆炸伤害死亡时，可能会触发特殊的死亡效果（如尸体爆炸）。"
autowrap_mode = 3

[node name="MarginContainer5" type="MarginContainer" parent="VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/margin_left = 55
theme_override_constants/margin_top = 110
theme_override_constants/margin_right = 55

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer5" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "各伤害类型总结"

[node name="MarginContainer6" type="MarginContainer" parent="VBoxContainer" index="7"]
layout_mode = 2
theme_override_constants/margin_top = 490

[node name="MarginContainer7" type="MarginContainer" parent="VBoxContainer" index="8"]
layout_mode = 2
theme_override_constants/margin_left = 50
theme_override_constants/margin_right = 50
theme_override_constants/margin_bottom = 130

[node name="VBoxContainer" type="VBoxContainer" parent="VBoxContainer/MarginContainer7" index="0"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Label" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 48
text = "秒杀机制"

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "秒杀是一类特殊的伤害结算方式，不经过常规的护甲/魔抗计算流程，而是直接判定目标死亡。游戏内分为 sec_kill 和 disappear_kill 两种类型。"
autowrap_mode = 3

[node name="MarginContainer" type="MarginContainer" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="2"]
layout_mode = 2
theme_override_constants/margin_top = 20

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="3"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "sec_kill（常规秒杀）"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="4"]
layout_mode = 2
text = "sec_kill 是游戏内最常见的秒杀方式，带有一个 explosion 的bool类型参数，用于控制是否触发尸体爆炸效果。
 
部分情况下可能会起到禁亡语的效果，比如鸡骑士如果被带explosion参数的伤害致死（包括秒杀攻击），则不会生成尸国小鬼。"
autowrap_mode = 3

[node name="MarginContainer2" type="MarginContainer" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="5"]
layout_mode = 2
theme_override_constants/margin_top = 20

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "disappear_kill（消失秒杀）"

[node name="Label6" type="Label" parent="VBoxContainer/MarginContainer7/VBoxContainer" index="7"]
layout_mode = 2
text = "disappear_kill 是一种更彻底的秒杀方式，不会走任何 die 相关处理，而是执行一套完全独立的处理流程。该秒杀执行时受击目标会立即消失，通常情况下为了补足视觉效果，会额外放置一团灰尘作为视觉特效残留。
 
该秒杀因为不走 die 相关处理，所以必定能够封禁亡语效果，比如鸡骑士的死亡生成尸国小鬼以及大刀兵的神赐技能，除非受击目标重写了disappear_kill的处理逻辑。"
autowrap_mode = 3

