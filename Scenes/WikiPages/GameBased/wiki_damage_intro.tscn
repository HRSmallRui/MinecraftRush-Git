theme_override_font_sizes/font_size = 36
text = "5.伤害值取整与生命值扣除"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer4/VBoxContainer/Damage9" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "最终伤害会被取整（保留一位小数），然后从目标生命值中扣除。物理伤害和魔法伤害的计算结果需要调用 snappedf （四舍五入）进行取整后再扣除。
 
如果最终伤害低于0，则伤害会自动取0为最终伤害。"
autowrap_mode = 3

