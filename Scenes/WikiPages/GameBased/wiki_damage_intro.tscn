theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "真实伤害"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer/Damage4" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "简称真伤，游戏内较为稀有的伤害类型，完全无视任何伤害抗性（护甲，魔法抗性，炮伤抗性），只会被总伤减免所减免。"
autowrap_mode = 3

[node name="Damage5" type="VBoxContainer" parent="VBoxContainer/MarginContainer3/VBoxContainer" index="6"]
layout_mode = 2
theme_override_constants/separation = 25

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer/Damage5" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "超级伤害"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer3/VBoxContainer/Damage5" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "简称超伤，游戏内最稀有的伤害类型，是比真伤更为高贵的存在，是完完全全的实际伤害和原始伤害相等的伤害类型，不会被任何抗性（哪怕是总伤减免）减免，但同时也不会被任何增益（如易伤）所加成。"
autowrap_mode = 3

