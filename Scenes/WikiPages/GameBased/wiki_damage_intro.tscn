theme_override_constants/separation = 25

[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer4/VBoxContainer/Damage5" index="0"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "1.前置检查"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer4/VBoxContainer/Damage5" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "进行伤害是否生效的判断，有三种情况会导致本次伤害不生效直接跳过后续所有步骤
 
 
1.目标已死亡：如果目标生命值 小于等于 0，本次伤害不生效。
 
2.伤害类型免疫：部分单位拥有特定伤害类型的免疫能力（该属性为bool类型的变量，如物理免疫，魔法免疫，炮伤免疫）。例如，某些单位可能免疫物理伤害或魔法伤害。当目标免疫当前伤害类型时，本次伤害不生效。
 
3.伤害被闪避： 传入的额外参数中有3种参数会影响是否闪避
 
    1）伤害来源：是否包含伤害来源，通常用于获取伤害来源命中率与本体闪避率进行比较。如果满足条件，通常有（目标命中率 - 本体闪避率）的概率闪避本次伤害。
 
    2）远程伤害：是否为远程攻击，通常TNT投掷不被视为远程伤害，但会被视为AOE伤害。
 
    3）AOE伤害：是否为范围伤害。
 
对于绝大部分单位来说，AOE伤害、远程伤害或无伤害来源的攻击，闪避通常不起作用。通常情况下，包含伤害来源的非远程近战伤害有概率被闪避（前提是目标命中率 - 本体闪避率不能低于0）。"
autowrap_mode = 3

