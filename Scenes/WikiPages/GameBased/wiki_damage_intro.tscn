[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer4/VBoxContainer/Damage8" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "总伤减免是一种通用且结算在最后的伤害减免效果，对所有伤害类型生效（超伤除外）：
 
最终伤害 = 三级伤害 x (1 - 总伤减免率)"
autowrap_mode = 3

