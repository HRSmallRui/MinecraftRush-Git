[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer4/VBoxContainer/Damage7" index="1"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "易伤会按百分比增加最终伤害（超伤不受影响）：
 
三级伤害 = 二级伤害 x (1 + 易伤率)"
autowrap_mode = 3

