[node name="WikiPageSkillRobort" instance=ExtResource("1_wf57l")]
offset_bottom = 2435.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "天雷"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_mc21a")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillConfig" index="1"]
text = "技能文本： 召唤闪电轰击目标区域，同时降下暴雨减速所有敌人
 
冷却时间： 50 秒"

[node name="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillConfig/CenterContainer/WikiTable/WikiTableElement2" index="0"]
text = "50 秒"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillEffect" index="1"]
text = "在指定位置召唤 3/4/5/6 发闪电，间隔 0.4 秒相继出现，每发闪电在 x方向随机偏移 0-60 像素，y方向随机偏移 0-45 像素，每发闪电对 130 范围内的所有敌人造成 50-75 点真伤，如果命中目标持有 \"creeper\" 标签则会对其施加 \"闪电护盾\" 效果并移除 \"creeper\" 标签，爆炸伤害和范围都会得到强化，同时获得 10 点魔抗强化。
 
若当前场景环境标签不持有 \"desert\"，还会额外召唤持续 4/5/6/8 秒的暴雨效果，持续减速全场敌人 40%。"

