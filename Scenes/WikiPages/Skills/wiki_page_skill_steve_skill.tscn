[node name="WikiPageSkillSteveSkill" instance=ExtResource("1_u46ch")]
offset_bottom = 3387.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "药水风暴雨"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_v5snv")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillConfig" index="1"]
text = "技能文本： 倾泻一场药水风暴，伤害敌人，并支援友军
 
冷却时间： 30 秒"

[node name="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillConfig/CenterContainer/WikiTable/WikiTableElement2" index="0"]
text = "30 秒"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillEffect" index="1"]
text = "在指定位置先后各自降下 2/4/6/8 发正面药水和负面药水，间隔 0.2 秒交替释放，每发药水落点位置随机在 x 方向偏移 0-25，y 方向偏移 0-18 像素。"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillEffect" index="2"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "正面药水"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillEffect" index="3"]
layout_mode = 2
text = "恢复 30 范围内所有友军 30 点生命，并施加持续 6 秒的超级恢复效果，每 0.5 秒恢复 10 点生命。如果落点 30 范围内存在持有 \"undead\" 标签的敌人，则会对其造成 30 点真伤。"
autowrap_mode = 3

