[node name="WikiPageSkillSteveSP" instance=ExtResource("1_4gumg")]
offset_bottom = 4443.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "旅程的问答"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_notxy")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillConfig" index="1"]
text = "技能文本
因何踏上旅程： 对范围内的敌人造成大量伤害并眩晕敌人
仍有要守护之物： 召唤一片领域，持续增益领域内的我方单位
 
冷却时间： 40 秒"

[node name="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillConfig/CenterContainer/WikiTable/WikiTableElement2" index="0"]
text = "40 秒"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillEffect" index="1"]
text = "史蒂夫拥有两个技能 - “因何踏上旅程” 和 “仍有要守护之物”。战斗开始时为前者，技能释放后都会立即替换为另一个技能并进入冷却。"

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillEffect" index="2"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "因何踏上旅程"

[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/SkillEffect" index="3"]
layout_mode = 2
text = "在指定区域释放一道天基炮，对 200 范围内所有敌人造成 40/60/80/100 点真伤，并对敌人施加持续 3 秒的减速效果和永久破甲效果。减速效果持续期间敌人减速 50%，破甲效果为削除敌人 20 点护甲。
 
1.2 秒后爆炸造成二段伤害， 对 240 范围内所有敌人造成 200/300/400/500 点炮伤，并移除敌人所有正面效果。敌人每持有 1 个史蒂夫施加的效果，二段伤害造成的伤害额外提高 20/30/40/50  点，最多叠加 5 层。爆炸结束时对范围内所有敌人施加持续 4 秒的眩晕效果。"
autowrap_mode = 3

