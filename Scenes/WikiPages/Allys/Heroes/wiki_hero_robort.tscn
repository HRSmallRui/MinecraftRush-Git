[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Based" index="3"]
layout_mode = 2
text = "持有标签：desert, no_live, robot
 
远程攻击方式：给目标施加一个持续 0.01X 秒的dot类debuff，每 0.01 秒对目标造成 1 真伤，X为本次远程攻击造成的伤害。
 
移动距离超过 190 时会瞬移至目标地点。"
autowrap_mode = 3

