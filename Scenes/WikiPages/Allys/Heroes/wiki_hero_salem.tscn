[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer" index="1"]
layout_mode = 2
text = "天生纯白面庞被视作不祥，饱受族人排挤。绝境中，不死骑士成为唯一接纳他的亲人，他与之缔结契约，习得诡谲瘟疫巫术 —— 契约生效时，两道暗红血泪自眼角蜿蜒而下，成了刻入骨髓的印记。如今他身披褴褛巫袍，周身萦绕腐臭瘴气，掌心凝毒雾、指尖生疫孢，以徒手瘟疫之力，向曾伤害他的世界复仇。
 
解锁条件： 通关第12关-丛林神殿"
autowrap_mode = 3

