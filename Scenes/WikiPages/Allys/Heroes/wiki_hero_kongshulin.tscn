[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Based" index="3"]
layout_mode = 2
text = "空树林的近战普攻为两段伤害结算，每次造成 0.5 倍面板伤害。"
autowrap_mode = 3

[node name="Label3" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Based" index="4"]
layout_mode = 2
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 36
text = "被动 - 命债"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Based" index="5"]
layout_mode = 2
text = "每当附近有一个敌人死亡时空树林获得一层命债，获得一层命债时空树林恢复自身 10% 生命，最多叠加 10 层，每当空树林受到致命伤害时，如果命债层数大于 8 ，则立即消耗 8 层命债免疫本次伤害并立即恢复自身 50% 生命。
 
每获得一层命债进入10 秒冷却期，期间无法再次获得命债。空树林初始持有 0 层命债，死亡时命债层数清零。
 
命债层数的具体数值显示在英雄头像的左下角"
autowrap_mode = 3

