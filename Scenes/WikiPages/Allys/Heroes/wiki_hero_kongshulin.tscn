[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer" index="1"]
layout_mode = 2
text = "空树林是人族帝国九大守卫者中最为飘忽的「巡猎者」，其掌管的力量能吞噬光明、融于暗影。他生性豪爽洒脱，常以烈酒佐刀锋，笑谈间便斩敌于无形。当帝国边境被阴影侵蚀时，这位总爱斜倚城墙观落日的刺客重新拾起长刀——以暗影为刃，噬尽诸敌，方是他对「追猎」二字最写意的诠释。
 
解锁条件： 通关第18关-诺冰要塞"
autowrap_mode = 3

