[node name="Label5" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Based" index="3"]
layout_mode = 2
text = "移动超过 180 长度会瞬移至目标地点。
 
攻击方式：
 
本体锁定当前拦截目标位置或自身射程内的地面单位（可发现隐身单位），释放 5 发光矛阵列，每个阵列偏移一定位置，对 75 范围内的所有地面敌人造成 20% 面板伤害。
 
魔法书浮游炮锁定 400 范围内的一名敌人（可发现隐身单位），发射一发魔法球光弹，造成 1 倍面板远程攻击伤害。"
autowrap_mode = 3

