text = "被动 - 赌徒筹码"

[node name="Label4" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer/Based" index="4"]
layout_mode = 2
text = "金钻持有名为 “筹码” 的特殊层数，每 7 秒获得一枚筹码，最多叠加 21 层，死亡时筹码清零，复活时立即获得 1-4 枚筹码，战斗波次开始时，金钻立即获得 5 枚筹码。
 
筹码的具体数值显示在英雄头像的左下角"
autowrap_mode = 3

