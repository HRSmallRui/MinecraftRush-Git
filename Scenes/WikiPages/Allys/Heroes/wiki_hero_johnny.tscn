[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer" index="1"]
layout_mode = 2
text = "出身底层的刌民，在厌鸣帝国的残酷统治下苟延残喘，受尽欺凌。忍无可忍之际，他振臂一呼集结同胞起义，浴血奋战中被敌军硬生生剜去一眼，却愈发悍勇无匹。如今他独眼燃着复仇烈焰，右手直接嵌上巨硕双刃斧，斧刃寒光凛冽、饮血无数。厌鸣帝国悬重金追缉这位“血枭”，但他凭雷霆斧法横扫千军，令敌军闻风丧胆，誓要为所有底层刌民劈开一条生路。
 
解锁条件： 通关第14关-林地府邸"
autowrap_mode = 3

