[node name="Label2" type="Label" parent="VBoxContainer/MarginContainer2/VBoxContainer" index="1"]
layout_mode = 2
text = "紫发垂肩如暗夜凝霞，本是被底层刌民偶然拾获的人类女婴，在乡野间被温柔抚养长大。成年后她觉醒暗黑之力，能潜于阴影无声穿梭，箭矢裹着暗影锋芒，出手便取敌性命。厌皇压迫与高层刌民的迫害，让养父母惨死，悲痛中她集结底层同胞踏上复仇之路。当史蒂夫一行途经林地府邸时，她率部投靠，正式归入人族帝国，以黯锋弩矢射穿所有残暴与不公。
 
解锁条件： 通关第16关-高山"
autowrap_mode = 3

