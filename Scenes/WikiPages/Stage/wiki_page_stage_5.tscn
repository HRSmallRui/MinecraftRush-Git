[node name="WikiPageStage5" instance=ExtResource("1_8slb0")]
offset_bottom = 8053.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "野区保护府"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_bgat5")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 5
 
配置： 2-1
 
前置关卡： 元帅府
 
所属章节： 主线第 2 章 - 丛林"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "尽管战争取得了胜利，但我们的探子传来消息称在上一战的途中有一支敌军往南部野区逃去。根据俘虏的口供，我们了解到这一支前往南部的敌军是为了找寻足以扭转残局的神器。
来不及准备了，将军，我们需要立即前去追击敌军，哪怕是深入数百年无人踏足的无人区。陛下将自己的皇家法师团派遣到你的麾下，确保此程的顺利。
但随着深入野区，我们所有人越发地不安，总觉得丛林深处有什么在看着我们……"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 800
 
总波次： 14
 
塔位数量： 15
 
关卡环境标签： 无"

