[node name="WikiPageStage13" instance=ExtResource("1_dp0hf")]
offset_bottom = 8140.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "粘液沼泽"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_xe1ig")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 13
 
配置： 4-2
 
前置关卡： 丛林神殿
 
所属章节： 主线第 4 章 - 厌国"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "这里的敌人很不正常，他们拥有远远出乎于我们意料之外的战斗力与不知名的武器。根据情报，所有的一切，包括战争，神器的抢夺，一切都是厌皇尼古拉斯的阴谋，目前神器就在尼古拉斯手上，而他也在前几日宣称厌鸣帝国即将成为世界的霸主。
好在当地仍有不满厌皇暴力统治的组织，我们顺利收编了一批不满于厌皇统治，倒戈的组织——医疗护卫队。然而我们的各项举动也引起了厌皇的注意，他正在派遣更多的军队赶来围剿。"

