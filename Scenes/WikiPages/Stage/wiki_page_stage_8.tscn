[node name="Label" parent="VBoxContainer" index="1"]
text = "卡瓦拉沙漠"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_lwi1x")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 8
 
配置： 3-1
 
前置关卡： 南洋海岸
 
所属章节： 主线第 3 章 - 沙漠"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "经过数天的航行，我们终于靠岸了。这是一片蛮荒之地，很遗憾我们失去了他们的踪迹，还来到了一片未知之地。比较奇特的是，我们遇到了一批神秘的部族，他们自称演算者，似乎能与神器碎片产生共鸣，给我们指明下一块碎片所在的方向。
就在他们为我们指明方向之后，我们发现这蛮荒之地竟然也是一片怪物遍地爬的蛮荒野区。他们很快注意到了我们，正向我们这边逼近。将军，准备开战！"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 1000
 
总波次： 14
 
塔位数量： 16
 
关卡环境标签： desert"

[node name="Label5" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="5"]
text = "初始绿宝石： 900
 
总波次： 5
 
塔位数量： 16
 
关卡环境标签： desert"

