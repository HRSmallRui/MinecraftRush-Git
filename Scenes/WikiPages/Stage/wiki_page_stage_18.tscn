[node name="WikiPageStage18" instance=ExtResource("1_lf0s0")]
offset_bottom = 11009.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "诺冰要塞"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_16cel")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 18
 
配置： 6-1
 
前置关卡： 鬼门关
 
所属章节： 主线第 6 章 - 凯旋"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "经由传送门之后，我们终于抵达祖国。战争仅持续了数个月，厌皇尼古拉斯便凭借他那强大的神器碾压了一切，将帝国逼入绝境。只有短暂的休整，将军，我们必须立刻前往诺冰要塞，在一切还来得及之前，或许我们还有翻盘的机会。
将军，时间不多了！我们必须立刻前往诺冰要塞——那里可能是我们唯一的希望！"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 500
 
总波次： 8
 
塔位数量： 24（包含1个流浪商人营地）
 
关卡环境标签： 无"

[node name="Label5" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="5"]
text = "初始绿宝石： 600
 
总波次： 5
 
塔位数量： 24（包含2个脉冲发射台，1个流浪商人营地）
 
关卡环境标签： 无"

[node name="Label7" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="8"]
text = "初始绿宝石： 2000
 
