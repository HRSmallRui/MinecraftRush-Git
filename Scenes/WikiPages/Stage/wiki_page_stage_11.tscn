[node name="WikiPageStage11" instance=ExtResource("1_sos42")]
offset_bottom = 10510.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "东海岸"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_fkx20")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 11
 
配置： 3-4
 
前置关卡： 绝望沙丘
 
所属章节： 主线第 3 章 - 沙漠"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "在绝望沙丘死里逃生之后，我军的士气一直低迷。唯一值得高兴的或许就是我们发现了一种高能液体，在演算者的协助下，我们有一项新技术即将突破。
赶到东海岸的时候，我们惊愕不已。我们确实追到了逃兵，但却都是……遍地的死尸！根据现场来看，他们本想驾船向东前行，却落得个船破人亡。我们翻遍了尸体，并没有找到他们偷走的神器碎片，只是隐约看到了远处有艘船驶离，或许神器碎片就在那艘不知名的船上。
来不及细细思考，那群怪物又来了！将军，做好战斗准备，在造船工完工之前我们需要保护好他们。而且似乎，造成这场悲剧的罪魁祸首就在不远处。"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 800
 
总波次： 16
 
塔位数量： 26（包含1个2级炮塔，2个隐藏塔位）
 
关卡环境标签： 无"

[node name="Label5" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="5"]
text = "初始绿宝石： 1200
 
