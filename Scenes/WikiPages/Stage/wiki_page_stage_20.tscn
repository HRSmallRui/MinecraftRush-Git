[node name="Label7" type="Label" parent="VBoxContainer/MarginContainer/VBoxContainer/Special" index="6"]
layout_mode = 2
text = "厌皇会时刻在场上，并在战斗期间干扰玩家。
 
封锁防御塔：9，11-15波期间，每 24 秒随机封锁 1-10 座防御塔，持续 8 秒。
 
摧毁防御塔：12-15波期间，每 62 秒随机摧毁一座防御塔。
 
降下雷电：3-15波期间，每 13 秒在随机我方单位位置降下闪电，对 200 范围内的所有我方单位造成 400-450 点真伤。"
autowrap_mode = 3

