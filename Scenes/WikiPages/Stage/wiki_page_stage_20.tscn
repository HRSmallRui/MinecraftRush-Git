[node name="WikiPageStage20" instance=ExtResource("1_dnvjl")]
offset_bottom = 7919.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "皇城"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_n88i3")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 20
 
配置： 6-3
 
前置关卡： 诺冰大峡谷
 
所属章节： 主线第 6 章 - 凯旋"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "干得漂亮，将军！在您的领导下，我们终于将战局逐渐扭转，现在我们的部队集结在皇城处，将此处里里外外围得水泄不通。厌皇尼古拉斯，这场战争的始作俑者，一切的罪魁祸首正躲在皇城内部，妄图做最后的挣扎。
将军，我们一路走来，绝不能在此刻出岔子！此刻我们的身后就是帝国的万家灯火，我们肩负着整个帝国的命运，一定要在此处彻底消灭厌皇和他的部队！ 为了帝国，为了皇帝陛下，为了帝国的千千万万的子民，我们赌上一切，包括自己的生命，完成这最后一战！"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 2200
 
总波次： 15
 
塔位数量： 47（包含10个隐藏塔位，2个骑士营地，2个脉冲发射台）
 
关卡环境标签： 无"

