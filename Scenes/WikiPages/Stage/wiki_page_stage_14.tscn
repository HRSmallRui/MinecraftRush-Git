[node name="WikiPageStage14" instance=ExtResource("1_axq62")]
offset_bottom = 10096.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "林地府邸"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_5mquu")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 14
 
配置： 4-3
 
前置关卡： 粘液沼泽
 
所属章节： 主线第 4 章 - 厌国"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "经过数周的跋涉，我们来到了厌国的军事要地——林地府邸。我们收编了当地备受歧视的低等刌民，他们愿意同我们一同战斗，将被欺压剥削的怒火宣泄到战场上。
这里离厌皇的皇宫不远了，此刻厌皇正躲在皇宫内部，根据丛林神殿里的神秘铭文研究神器力量的使用。将军，我们要赶快了！一旦厌皇掌控了神器的力量，我们谁也不能保证会发生什么可以预料的事情！"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 1000
 
总波次： 15
 
塔位数量： 34（包含3个隐藏塔位）
 
关卡环境标签： 无"

