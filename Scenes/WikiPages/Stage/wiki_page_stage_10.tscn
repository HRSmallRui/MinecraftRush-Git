[node name="WikiPageStage10" instance=ExtResource("1_lqs51")]
offset_bottom = 11367.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "绝望沙丘"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_wqwcc")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 10
 
配置： 3-3
 
前置关卡： 沙漠神殿
 
所属章节： 主线第 3 章 - 沙漠"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "神殿是空的！我们清理完威胁之后终于得以进入沙漠神殿，却发现内部洗劫一空的惨象。我们推测或许是那些逃军先我们一步赶到这里，拿走了宝物。根据守卫者的指引，我们一路向东南方向前进，我们一定要追到他们！
但是我们没想到这种怪物横行的地带竟会有多处人烟之地，好消息是我们得到了当地一个拜神教会的帮助，扩大了我军的力量，坏消息是，我们遭遇了沙漠土匪的袭击。将军，我们要列阵防守，击溃这些蛮夷了。"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 1200
 
总波次： 15
 
塔位数量： 16（包含1个沙漠雇佣兵营地）
 
关卡环境标签： desert"

[node name="Label5" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="5"]
text = "初始绿宝石： 1000
 
总波次： 5
 
塔位数量： 16（包含1个沙漠雇佣兵营地，1个大刀教会）
 
关卡环境标签： desert"

[node name="Label7" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="8"]
text = "初始绿宝石： 1400
 
总波次： 1
 
塔位数量： 16（包含2个沙漠雇佣兵营地，1个演算者炮塔）
 
关卡环境标签： desert"

[node name="WikiStageViewTexture" parent="VBoxContainer/MarginContainer/VBoxContainer/EnemyPath" index="1"]
texture = ExtResource("3_8f63w")

