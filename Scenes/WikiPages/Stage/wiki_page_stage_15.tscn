[node name="WikiPageStage15" instance=ExtResource("1_g4gof")]
offset_bottom = 7494.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "海底神殿"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_ptc04")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 15
 
配置： 4-4
 
前置关卡： 林地府邸
 
所属章节： 主线第 4 章 - 厌国"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "厌皇调出了更多的军队赶来剿杀，我们在其诡异的武器下只得接连败退，退到了最东边的海滩。值得庆幸的是，我们遇到了一批炼金术士，隐居世间的他们同样痛恨厌皇的残暴统治，愿意加入我们击溃厌皇。
将军，我们不能再后退了。而且根据消息，刚才厌皇正在整顿军队准备向北而行进攻帝国。我们必须杀出重围，赶紧回国支援。
将军，在这种情况下貌似还有一个更糟的坏消息：海底有什么在涌动……"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 2200
 
总波次： 15
 
塔位数量： 29（包含5个隐藏塔位）
 
关卡环境标签： 无"

