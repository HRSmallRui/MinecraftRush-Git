[node name="WikiPageStage9" instance=ExtResource("1_qeo2o")]
offset_bottom = 10833.0

[node name="Label" parent="VBoxContainer" index="1"]
text = "沙漠神殿"

[node name="TextureRect" parent="VBoxContainer" index="2"]
texture = ExtResource("2_het04")

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Info" index="1"]
text = "关卡序号： 9
 
配置： 3-2
 
前置关卡： 卡瓦拉沙漠
 
所属章节： 主线第 3 章 - 沙漠"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Story" index="1"]
text = "真是一片神奇的大陆，这里几乎都是荒漠地带，属于无人野区，也有许多怪物游荡。但是我们却在这片地区找到了少有的人烟地带，并招募了一批刺客护送我们。
很快演算者们护送我们来到了他们口中供奉神灵的神庙，称我们所要的失落宝藏与那神器碎片或许就在里面。但是将军，我们或许要开战了，那些怪物又追来了。
还有，将军，这座诡异的神庙貌似对我们抱有敌意……"

[node name="Label2" parent="VBoxContainer/MarginContainer/VBoxContainer/Config" index="2"]
text = "初始绿宝石： 800
 
总波次： 15
 
塔位数量： 19
 
关卡环境标签： desert"

