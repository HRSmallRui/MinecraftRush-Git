theme_override_fonts/font = ExtResource("4_iduhl")
theme_override_font_sizes/font_size = 64
text = "每个波次开始改变一次天气效果，分为晴天/小雨/中雨/大雨/雷暴雨，随等级提升视野会越来越暗
雨天会对终末持续造成真实伤害，雨天等级越高，对终末造成的高频伤害越高
雷暴雨时会每隔一段时间进行一次打闪，每次打闪时场上所有腐化爬行者都有概率获得闪电效果：获得额外魔法抗性，提高爆炸伤害与爆炸范围"
autowrap_mode = 3
visible_characters = 0
visible_ratio = 0.0

