[resource]
script = ExtResource("1_k0bma")
skill_name = "钻石镐"
skill_intro = Array[String](["挥动钻石镐，对面前敌人造成70-82点无视护甲的物理伤害，并削除敌人10点护甲。", "挥动钻石镐，对面前敌人造成84-96点无视护甲的物理伤害，并削除敌人20点护甲。", "挥动钻石镐，对面前敌人造成100-122点无视护甲的物理伤害，并削除敌人30点护甲。"])
