[ext_resource type="Script" path="res://Library/Heroes/hero_skill_text_block.gd" id="1_gglw6"]

[resource]
script = ExtResource("1_gglw6")
skill_name = "胜利旌旗"
skill_intro = Array[String](["在指定位置召唤胜利旌旗 持续6秒，持续期间作用范围内所有友军获得60%伤害加成并无敌，防御塔获得50%伤害加成。", "在指定位置召唤胜利旌旗 持续8秒，持续期间作用范围内所有友军获得60%伤害加成并无敌，防御塔获得50%伤害加成。", "在指定位置召唤胜利旌旗 持续10秒，持续期间作用范围内所有友军获得60%伤害加成并无敌，防御塔获得50%伤害加成。"])
