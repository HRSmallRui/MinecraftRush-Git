script = ExtResource("1_huu5r")
skill_name = "破甲匕首"
skill_intro = Array[String](["塔尔辛的近战普通攻击将无视敌人护甲，并且每次近战伤害将永久削除敌人4点护甲。", "塔尔辛的近战普通攻击将无视敌人护甲，并且每次近战伤害将永久削除敌人8点护甲。", "塔尔辛的近战普通攻击将无视敌人护甲，并且每次近战伤害将永久削除敌人12点护甲。"])
