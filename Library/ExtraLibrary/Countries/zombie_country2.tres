[resource]
script = ExtResource("1_amd5t")
title = "尸族帝国其二"
content = "抗厌战争期间，战局一度胶着。尼古拉斯为打破僵局，遣使与尸、骨两国密约结盟，许以战后分地。尸骨两国应允，各遣精锐助战。然战事进行至关键阶段，尸国统帅炎阳赫斯菲与骨国统帅萨图恩・骨斯奇突然临阵倒戈，反攻厌军侧翼。厌军阵脚大乱，人国史蒂夫乘势合击，厌军溃败，尼古拉斯败死阵中。此事是厌鸣战败的直接转折点，后世的战史研究者无论站在哪一方，都不得不承认——若非此二人倒戈，战局未必如此收场。
 
战罢，赫斯菲与骨斯奇未作片刻停留，各自引残部归国，卸甲入朝，坦然受审。两国朝廷的判决出奇一致：以“违抗军令、擅自毁盟”为由判处斩立决，家产充公，其名列入罪臣录，世代不得翻案。官方史书如此记载：二人背信弃义，贻笑天下，遗臭万年。然而民间所传却与之大相径庭。尸国市井间有歌谣流传，唱的是“赤葵不向金殿转，只照苍生血路行”；骨国矿工中亦有言，“岩维恩家的皇帝坐朝，骨斯奇家的人埋土，埋的却是厌鸣的旗。”两国朝廷屡次禁绝此类言论，然屡禁不止，歌照唱，话照传。赫斯菲与骨斯奇死后，民间有人在边野之地私立小祠，无碑无匾，仅插葵花与土牛花各一枝。官方闻之即拆，拆了又立，如是者数年，遂懒得再管。
 
此事之奇，不在倒戈本身，而在民心。两国朝廷皆以叛逆定罪，两国百姓却以英雄视之。何者为真，何者为伪，后世史家各执一词，至今无定论。"
background_texture_path = ""
texture_alpha = 0.4
unlock_tag = "normal"
