[resource]
script = ExtResource("1_yffvn")
title = "厌鸣帝国其三"
content = "神器的碎片并没有被全部找回。欧姆死后，特斯拉家族中曾有人尝试拼合神器，但其碎片散落范围过大，涉及尸国、骨国、人国甚至白夕遗址等多片大陆，远非厌鸣一国之力所能及。特斯拉家族被迫退居大陆南方，在皇权收缩的数百年间，神器的存在逐渐从厌鸣的公开记忆中淡出，只留存于皇室秘档与旧族口传之中。直到尼古拉斯即位，以数十年的暗中经营重新收集碎片，拼合残缺，神器才重新回到厌鸣权力的中心——但那时它已是另一种东西了。欧姆当年凭借完整的神器一统大陆，尼古拉斯凭借重组的神器入侵人国，最终战败身死——神器仿佛以一种近乎宿命的方式，同时承载着特斯拉家族最辉煌的胜利与最彻底的失败。
 
有史家如此概括这段历史：“神器给了欧姆一切，也毁了他的一切。尼古拉斯试图重复这条路径，然后被这条路径压垮。伏特是特斯拉家族第一个说出‘那东西不该再出现’的人——或许这句话，才是特斯拉家族四百年来最清醒的判断。”"
background_texture_path = "res://Assets/Images/UI/Extra/ExtraBookBackground/紫罗兰.png"
texture_alpha = 0.4
unlock_tag = "normal"
