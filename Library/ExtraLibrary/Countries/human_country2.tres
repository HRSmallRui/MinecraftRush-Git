[resource]
script = ExtResource("1_riwgn")
title = "人族帝国其二"
content = "人族帝国虽为封建帝制，军权受朝堂多方掣肘，但有一支力量长期独立于常规军制之外——九大守卫者。他们并非神祇，亦非超然于世的隐士，而是比常人更强一些的将领，各自统领一支精锐部属，拱卫帝国疆域与皇权核心。其独特之处在于：每一位守卫者的称号，同时代表着他终生践行的信条与赖以立身的专长。能力即信仰，信仰即能力，二者互为表里。
 
九大守卫者分别为：守护、湮灭、观测、追猎、天慧、誓约、祝福、诅咒、天启。
 
九大守卫者皆为传承制。每一位现任守卫者在任期内须培养数名候选者——可以是亲生子女，亦可为军中弟子、学堂高徒，唯才是举，不拘出身。当守卫者因年迈、伤病或自愿提前退休时，便从候选者中择一人接替其称号，继承其部属与信仰。此制已在人族帝国运行数百年，是帝国军制中最具稳定性的传承环节。帝国内部有俗语称：“皇帝是坐着的，守卫者是站着的。皇帝换人不换座，守卫者换号不换人。”
 
守卫者的选拔与传承亦有严格限制。候选者须具备三项基本条件：武艺或谋略达到一定水准；对所选称号的信条有深刻理解；通过现任守卫者的最终试炼。试炼失败者退回原职，终生不得再竞逐守卫者之位。而试炼通过者，将在朝堂上接受皇帝册封，正式成为新一代守卫者。
  
九大守卫者虽各司其职，然其权力并非无限。征调守卫者需经廷议批准，守卫者不得擅自出兵；守卫者的军费开支由朝堂预算单独列支，受户部审核；若守卫者叛国或严重失职，由天启守卫者联合至少三位同僚共同审理，皇帝亦无法单独赦免。这种层层嵌套的制衡关系，既保证了守卫者体系的独立性，也防止了它成为新的僭主权柄。"
background_texture_path = "res://Assets/Images/UI/Extra/ExtraBookBackground/雏菊.png"
texture_alpha = 0.4
unlock_tag = "normal"
