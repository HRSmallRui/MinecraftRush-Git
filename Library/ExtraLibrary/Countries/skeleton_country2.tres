[resource]
script = ExtResource("1_p5d0x")
title = "骨族帝国其二"
content = "抗厌战争期间，骨国统帅萨图恩・骨斯奇与尸国统帅炎阳赫斯菲联手倒戈一事，详见尸国本纪。骨斯奇归国受审之时，议会曾有过激烈争论——有议员提出“临阵易帜固然违令，然厌鸣本非可信之盟，此战实为弃暗投明，可否从轻发落”。然皇帝梅比尔・岩维恩最终拍板：军令如山，无分对错，违者当斩。判决下达后，骨斯奇面无惧色，仅一言：“行我当行，受我当受。”遂赴死。
 
骨国官方将此案定性为“骨斯奇叛国案”，写入法典，以为军人之戒。然民间矿工与行会中，骨斯奇的名声始终不坠。甚至有行会暗中以“骨斯奇”命名其内部互助基金，取其“宁负己名、不负初心”之意。议会多次闻报，皆以“无实据”为由不予深究。有议会议员私下对人言：“有些事，写进书里是一套，刻在人心是另一套。我们禁得了书，禁不了心。”"
background_texture_path = ""
texture_alpha = 0.4
unlock_tag = "normal"
